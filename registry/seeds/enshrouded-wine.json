{
  "schemaVersion": "dauva.dev/seed/v1",
  "id": "enshrouded-wine",
  "version": "1.0.1-rc.1",
  "status": "candidate",
  "podId": "enshrouded",
  "genres": [
    "adventure",
    "cooperative",
    "survival"
  ],
  "metadata": {
    "title": {
      "en": "Enshrouded Wine — Recommended",
      "nl": "Enshrouded Wine — Aanbevolen",
      "de": "Enshrouded Wine — Empfohlen"
    },
    "description": {
      "en": "An Enshrouded Server on the maintained Wine runtime with scheduled local backups.",
      "nl": "Een Enshrouded-Server op de onderhouden Wine-runtime met geplande lokale back-ups.",
      "de": "Ein Enshrouded-Server auf der gepflegten Wine-Laufzeit mit geplanten lokalen Backups."
    },
    "icon": "flame"
  },
  "compatibility": {
    "operatingSystems": [
      "linux"
    ],
    "architectures": [
      "amd64"
    ],
    "leafCapabilities": [
      "dynamic-ports",
      "oci",
      "persistent-storage",
      "resource-limits"
    ]
  },
  "components": [
    {
      "id": "server",
      "role": "primary",
      "image": "docker.io/mornedhels/enshrouded-server@sha256:6bd473b78e5331a0fc86553d9e9ddef5c712d7e9b356af385aa90e772f931019",
      "imageUpdate": {
        "reference": "docker.io/mornedhels/enshrouded-server:stable-wine"
      },
      "environment": {
        "BACKUP_CRON": "0 */6 * * *",
        "BACKUP_MAX_COUNT": "24",
        "GAME_BRANCH": "public",
        "PGID": "4711",
        "PUID": "4711",
        "SERVER_IP": "0.0.0.0",
        "SERVER_ROLE_0_CAN_ACCESS_INVENTORIES": "true",
        "SERVER_ROLE_0_CAN_EDIT_BASE": "true",
        "SERVER_ROLE_0_CAN_EDIT_WORLD": "true",
        "SERVER_ROLE_0_CAN_EXTEND_BASE": "true",
        "SERVER_ROLE_0_CAN_KICK_BAN": "true",
        "SERVER_ROLE_0_NAME": "Admins"
      },
      "optionEnvironment": {
        "server-slots": "SERVER_SLOT_COUNT"
      },
      "agreementEnvironment": {},
      "secretEnvironment": {
        "admin-password": "SERVER_ROLE_0_PASSWORD"
      },
      "runtimeEnvironment": {
        "serverName": "SERVER_NAME",
        "primaryPort": "SERVER_QUERYPORT"
      },
      "volumeMounts": [
        {
          "volumeId": "data",
          "target": "/opt/enshrouded",
          "readOnly": false
        }
      ],
      "dependsOn": [],
      "health": {
        "source": "running",
        "startupGraceSeconds": 1800
      }
    }
  ],
  "volumes": [
    {
      "id": "data",
      "role": "data",
      "retention": "delete-with-server",
      "ownerUid": 4711,
      "ownerGid": 4711,
      "directoryMode": "0750"
    }
  ],
  "ports": [
    {
      "id": "game",
      "componentId": "server",
      "containerPort": 15637,
      "containerPortMode": "allocated",
      "protocols": [
        "udp"
      ],
      "exposure": "public",
      "purpose": "game",
      "primary": true,
      "sharedHostPort": true,
      "environment": "SERVER_QUERYPORT"
    }
  ],
  "resources": {
    "defaultPresetId": "large",
    "presets": [
      {
        "id": "large",
        "title": {
          "en": "Large",
          "nl": "Groot",
          "de": "Groß"
        },
        "description": {
          "en": "Minimum target for the current Proton-based runtime.",
          "nl": "Minimaal doel voor de huidige Proton-runtime.",
          "de": "Mindestziel für die aktuelle Proton-basierte Laufzeit."
        },
        "memoryMb": 8192,
        "diskMb": 40960,
        "cpuPercent": 300
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-steam-agreement",
      "type": "agreement",
      "label": {
        "en": "Steam Subscriber Agreement",
        "nl": "Steam Subscriber Agreement",
        "de": "Steam-Nutzungsvertrag"
      },
      "help": {
        "en": "I have read and accept the Steam Subscriber Agreement and the applicable Enshrouded terms.",
        "nl": "Ik heb de Steam Subscriber Agreement en de toepasselijke Enshrouded-voorwaarden gelezen en accepteer deze.",
        "de": "Ich habe den Steam-Nutzungsvertrag und die anwendbaren Enshrouded-Bedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://store.steampowered.com/subscriber_agreement/",
      "revision": "official-current"
    },
    {
      "key": "server-slots",
      "type": "integer",
      "label": {
        "en": "Player slots",
        "nl": "Spelersplaatsen",
        "de": "Spielerplätze"
      },
      "help": {
        "en": "Maximum simultaneous players, up to 16.",
        "nl": "Maximaal aantal gelijktijdige spelers, tot 16.",
        "de": "Maximale Anzahl gleichzeitiger Spieler, bis zu 16."
      },
      "required": true,
      "defaultValue": "16",
      "minLength": 1,
      "maxLength": 2
    }
  ],
  "secrets": [
    {
      "key": "admin-password",
      "source": "admin",
      "label": {
        "en": "Administrator password",
        "nl": "Beheerderswachtwoord",
        "de": "Administratorpasswort"
      },
      "help": {
        "en": "Used for the initial administrator group and never stored in the Dauva Server record.",
        "nl": "Wordt gebruikt voor de eerste beheerdersgroep en nooit opgeslagen in het Dauva Server-record.",
        "de": "Wird für die erste Administratorgruppe verwendet und nie im Dauva-Server-Datensatz gespeichert."
      },
      "minLength": 5,
      "maxLength": 128
    }
  ],
  "lifecycle": {
    "startOrder": [
      "server"
    ],
    "stopOrder": [
      "server"
    ],
    "stopTimeoutSeconds": 180
  },
  "capabilities": {
    "backup": true,
    "restore": false,
    "update": false,
    "console": false
  },
  "source": {
    "kind": "oci",
    "homepage": "https://enshrouded.com/",
    "repository": "https://hub.docker.com/r/mornedhels/enshrouded-server",
    "imageRegistries": [
      "docker.io"
    ]
  },
  "trust": {
    "level": "curated",
    "reviewedAt": "2026-07-26",
    "mutableRuntimeImagesAllowed": false
  },
  "storage": {
    "class": "bulk",
    "backupClass": "backup",
    "estimatedDownloadMb": 9000,
    "estimatedInstallMb": 18000,
    "estimatedMutableMb": 12288,
    "backupPolicy": "recommended"
  },
  "updatePolicy": {
    "discovery": "oci-tag",
    "automaticCheck": true,
    "automaticInstall": false,
    "requiresBackup": true,
    "rollback": true
  },
  "proofPolicy": {
    "requiredChecks": [
      "images-pinned",
      "healthy",
      "ports",
      "backup-if-supported",
      "graceful-stop",
      "restart",
      "persistence",
      "cleanup"
    ],
    "expiresAfterDays": 90
  }
}
