{
  "schemaVersion": "dauva.dev/seed/v1",
  "id": "satisfactory",
  "version": "1.0.0",
  "status": "stable",
  "podId": "satisfactory",
  "genres": [
    "automation",
    "simulation"
  ],
  "metadata": {
    "title": {
      "en": "Satisfactory Stable",
      "nl": "Satisfactory Stable",
      "de": "Satisfactory Stable"
    },
    "description": {
      "en": "A persistent Satisfactory Server that follows the stable Steam branch.",
      "nl": "Een blijvende Satisfactory-Server die de stabiele Steam-tak volgt.",
      "de": "Ein persistenter Satisfactory-Server auf dem stabilen Steam-Zweig."
    },
    "icon": "settings"
  },
  "compatibility": {
    "operatingSystems": [
      "linux"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "components": [
    {
      "id": "server",
      "role": "primary",
      "image": "docker.io/wolveix/satisfactory-server@sha256:e103700ae6ae4c50f19dac80eadb2a805c5b885e179ae2a40850e967bf189efd",
      "imageUpdate": {
        "reference": "docker.io/wolveix/satisfactory-server:latest"
      },
      "environment": {
        "AUTOSAVENUM": "10",
        "DISABLESEASONALEVENTS": "false",
        "ROOTLESS": "false",
        "SKIPUPDATE": "false",
        "STEAMBETA": "false"
      },
      "optionEnvironment": {
        "max-players": "MAXPLAYERS",
        "max-tick-rate": "MAXTICKRATE"
      },
      "agreementEnvironment": {},
      "secretEnvironment": {},
      "runtimeEnvironment": {
        "primaryPort": "SERVERGAMEPORT",
        "timezone": "TZ"
      },
      "volumeMounts": [
        {
          "volumeId": "config",
          "target": "/config",
          "readOnly": false
        }
      ],
      "dependsOn": [],
      "health": {
        "source": "container",
        "startupGraceSeconds": 1200
      }
    }
  ],
  "volumes": [
    {
      "id": "config",
      "role": "data",
      "retention": "delete-with-server"
    }
  ],
  "ports": [
    {
      "id": "game",
      "componentId": "server",
      "containerPort": 7777,
      "containerPortMode": "allocated",
      "protocols": [
        "tcp",
        "udp"
      ],
      "exposure": "public",
      "purpose": "game",
      "primary": true,
      "sharedHostPort": true,
      "environment": "SERVERGAMEPORT"
    },
    {
      "id": "messaging",
      "componentId": "server",
      "containerPort": 8888,
      "containerPortMode": "allocated",
      "protocols": [
        "tcp"
      ],
      "exposure": "public",
      "purpose": "messaging",
      "primary": false,
      "sharedHostPort": true,
      "environment": "SERVERMESSAGINGPORT"
    }
  ],
  "resources": {
    "defaultPresetId": "balanced",
    "presets": [
      {
        "id": "balanced",
        "title": {
          "en": "Balanced",
          "nl": "Gebalanceerd",
          "de": "Ausgewogen"
        },
        "description": {
          "en": "Minimum practical resources for a small factory.",
          "nl": "Minimaal praktische resources voor een kleine fabriek.",
          "de": "Praktische Mindestressourcen für eine kleine Fabrik."
        },
        "memoryMb": 8192,
        "diskMb": 30720,
        "cpuPercent": 250
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-steam-agreement",
      "type": "agreement",
      "label": {
        "en": "Steam Subscriber Agreement",
        "nl": "Steam Subscriber Agreement",
        "de": "Steam-Nutzungsvertrag"
      },
      "help": {
        "en": "I have read and accept the Steam Subscriber Agreement and the applicable Satisfactory terms.",
        "nl": "Ik heb de Steam Subscriber Agreement en de toepasselijke Satisfactory-voorwaarden gelezen en accepteer deze.",
        "de": "Ich habe den Steam-Nutzungsvertrag und die anwendbaren Satisfactory-Bedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://store.steampowered.com/subscriber_agreement/",
      "revision": "official-current"
    },
    {
      "key": "max-players",
      "type": "integer",
      "label": {
        "en": "Maximum players",
        "nl": "Maximumaantal spelers",
        "de": "Maximale Spielerzahl"
      },
      "help": {
        "en": "Maximum simultaneous players.",
        "nl": "Maximaal aantal gelijktijdige spelers.",
        "de": "Maximale Anzahl gleichzeitiger Spieler."
      },
      "required": true,
      "defaultValue": "8",
      "minLength": 1,
      "maxLength": 2
    },
    {
      "key": "max-tick-rate",
      "type": "integer",
      "label": {
        "en": "Maximum tick rate",
        "nl": "Maximale tickrate",
        "de": "Maximale Tickrate"
      },
      "help": {
        "en": "Upper simulation tick-rate limit.",
        "nl": "Bovengrens voor de simulatietickrate.",
        "de": "Obergrenze für die Simulations-Tickrate."
      },
      "required": true,
      "defaultValue": "30",
      "minLength": 1,
      "maxLength": 3
    }
  ],
  "secrets": [],
  "lifecycle": {
    "startOrder": [
      "server"
    ],
    "stopOrder": [
      "server"
    ],
    "stopTimeoutSeconds": 180
  },
  "capabilities": {
    "backup": false,
    "restore": false,
    "update": false,
    "console": false
  }
}
