{
  "schemaVersion": "dauva.dev/seed/v1",
  "id": "garrys-mod-flatgrass",
  "version": "1.0.1-rc.1",
  "status": "candidate",
  "podId": "garrys-mod",
  "genres": [
    "sandbox"
  ],
  "metadata": {
    "title": {
      "en": "Garry's Mod Flatgrass",
      "nl": "Garry's Mod Flatgrass",
      "de": "Garry's Mod Flatgrass"
    },
    "description": {
      "en": "A vanilla Sandbox Server that starts on gm_flatgrass.",
      "nl": "Een vanilla Sandbox-Server die start op gm_flatgrass.",
      "de": "Ein Vanilla-Sandbox-Server, der auf gm_flatgrass startet."
    },
    "icon": "toolbox"
  },
  "compatibility": {
    "operatingSystems": [
      "linux"
    ],
    "architectures": [
      "amd64"
    ],
    "leafCapabilities": [
      "dynamic-ports",
      "multi-port",
      "oci",
      "persistent-storage",
      "resource-limits"
    ]
  },
  "components": [
    {
      "id": "server",
      "role": "primary",
      "image": "docker.io/ceifa/garrysmod@sha256:e3494a218ee06e82ea7d80fcf7530a22fd833a6720f81b70e05b8e18d12b933c",
      "imageUpdate": {
        "reference": "docker.io/ceifa/garrysmod:ubuntu"
      },
      "environment": {
        "GAMEMODE": "sandbox",
        "MAP": "gm_flatgrass",
        "PRODUCTION": "1"
      },
      "optionEnvironment": {
        "max-players": "MAXPLAYERS"
      },
      "agreementEnvironment": {},
      "secretEnvironment": {},
      "runtimeEnvironment": {
        "serverName": "HOSTNAME"
      },
      "volumeMounts": [
        {
          "volumeId": "data",
          "target": "/home/gmod/server/garrysmod/data",
          "readOnly": false
        },
        {
          "volumeId": "addons",
          "target": "/home/gmod/server/garrysmod/addons",
          "readOnly": false
        }
      ],
      "dependsOn": [],
      "health": {
        "source": "container",
        "startupGraceSeconds": 900
      }
    }
  ],
  "volumes": [
    {
      "id": "data",
      "role": "save",
      "retention": "delete-with-server",
      "ownerUid": 1000,
      "ownerGid": 1000,
      "directoryMode": "0770"
    },
    {
      "id": "addons",
      "role": "data",
      "retention": "delete-with-server",
      "ownerUid": 1000,
      "ownerGid": 1000,
      "directoryMode": "0770"
    }
  ],
  "ports": [
    {
      "id": "game",
      "componentId": "server",
      "containerPort": 27015,
      "containerPortMode": "allocated",
      "protocols": [
        "tcp",
        "udp"
      ],
      "exposure": "public",
      "purpose": "game",
      "primary": true,
      "sharedHostPort": true,
      "environment": "PORT"
    },
    {
      "id": "client",
      "componentId": "server",
      "containerPort": 27005,
      "containerPortMode": "fixed",
      "protocols": [
        "udp"
      ],
      "exposure": "public",
      "purpose": "query",
      "primary": false,
      "sharedHostPort": true
    }
  ],
  "resources": {
    "defaultPresetId": "balanced",
    "presets": [
      {
        "id": "balanced",
        "title": {
          "en": "Balanced",
          "nl": "Gebalanceerd",
          "de": "Ausgewogen"
        },
        "description": {
          "en": "For a small vanilla Sandbox Server.",
          "nl": "Voor een kleine vanilla Sandbox-Server.",
          "de": "Für einen kleinen Vanilla-Sandbox-Server."
        },
        "memoryMb": 3072,
        "diskMb": 12288,
        "cpuPercent": 200
      },
      {
        "id": "large",
        "title": {
          "en": "Large",
          "nl": "Groot",
          "de": "Groß"
        },
        "description": {
          "en": "Extra headroom for persistent addons and more players.",
          "nl": "Extra ruimte voor blijvende addons en meer spelers.",
          "de": "Zusätzliche Reserven für persistente Addons und mehr Spieler."
        },
        "memoryMb": 6144,
        "diskMb": 24576,
        "cpuPercent": 300
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-steam-agreement",
      "type": "agreement",
      "label": {
        "en": "Steam Subscriber Agreement",
        "nl": "Steam Subscriber Agreement",
        "de": "Steam-Nutzungsvertrag"
      },
      "help": {
        "en": "I have read and accept the Steam Subscriber Agreement and the applicable game terms.",
        "nl": "Ik heb de Steam Subscriber Agreement en de toepasselijke gamevoorwaarden gelezen en accepteer deze.",
        "de": "Ich habe den Steam-Nutzungsvertrag und die anwendbaren Spielbedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://store.steampowered.com/subscriber_agreement/",
      "revision": "official-current"
    },
    {
      "key": "max-players",
      "type": "integer",
      "label": {
        "en": "Maximum players",
        "nl": "Maximumaantal spelers",
        "de": "Maximale Spielerzahl"
      },
      "help": {
        "en": "Maximum simultaneous players.",
        "nl": "Maximaal aantal gelijktijdige spelers.",
        "de": "Maximale Anzahl gleichzeitiger Spieler."
      },
      "required": true,
      "defaultValue": "16",
      "minLength": 1,
      "maxLength": 3
    }
  ],
  "secrets": [],
  "lifecycle": {
    "startOrder": [
      "server"
    ],
    "stopOrder": [
      "server"
    ],
    "stopTimeoutSeconds": 120
  },
  "capabilities": {
    "backup": false,
    "restore": false,
    "update": false,
    "console": false
  },
  "source": {
    "kind": "oci",
    "homepage": "https://gmod.facepunch.com/",
    "repository": "https://github.com/ceifa/garrysmod-docker",
    "imageRegistries": [
      "docker.io"
    ],
    "upstreamId": "steam:4020"
  },
  "trust": {
    "level": "curated",
    "reviewedAt": "2026-07-26",
    "mutableRuntimeImagesAllowed": false
  },
  "storage": {
    "class": "fast",
    "backupClass": "backup",
    "estimatedDownloadMb": 5200,
    "estimatedInstallMb": 9000,
    "estimatedMutableMb": 8192,
    "backupPolicy": "recommended"
  },
  "updatePolicy": {
    "discovery": "oci-tag",
    "automaticCheck": true,
    "automaticInstall": false,
    "requiresBackup": false,
    "rollback": true
  },
  "proofPolicy": {
    "requiredChecks": [
      "images-pinned",
      "healthy",
      "ports",
      "backup-if-supported",
      "graceful-stop",
      "restart",
      "persistence",
      "cleanup"
    ],
    "expiresAfterDays": 90
  }
}
