{
  "schemaVersion": "dauva.dev/seed/v1",
  "id": "terraria-vanilla",
  "version": "1.0.0",
  "status": "stable",
  "podId": "terraria",
  "genres": [
    "adventure",
    "sandbox",
    "survival"
  ],
  "metadata": {
    "title": {
      "en": "Terraria Vanilla",
      "nl": "Terraria Vanilla",
      "de": "Terraria Vanilla"
    },
    "description": {
      "en": "The official vanilla dedicated Server with graceful world saves.",
      "nl": "De officiële vanilla dedicated Server met nette wereldopslag bij stoppen.",
      "de": "Der offizielle Vanilla-Dedicated-Server mit sauberem Speichern beim Stoppen."
    },
    "icon": "gem"
  },
  "compatibility": {
    "operatingSystems": [
      "linux"
    ],
    "architectures": [
      "amd64"
    ],
    "leafCapabilities": [
      "dynamic-ports",
      "oci",
      "persistent-storage",
      "resource-limits"
    ]
  },
  "components": [
    {
      "id": "server",
      "role": "primary",
      "image": "docker.io/brammys/terraria@sha256:5b33a335dd6b250caa4858b00388102bcf87a02b311e6635fd013d3a564a430a",
      "imageUpdate": {
        "reference": "docker.io/brammys/terraria:latest"
      },
      "environment": {
        "TERRARIA_NOUPNP": "1",
        "TERRARIA_SECURE": "1"
      },
      "optionEnvironment": {
        "max-players": "TERRARIA_MAXPLAYERS",
        "world-name": "TERRARIA_WORLD",
        "world-size": "TERRARIA_AUTOCREATE"
      },
      "agreementEnvironment": {},
      "secretEnvironment": {
        "server-password": "TERRARIA_PASSWORD"
      },
      "runtimeEnvironment": {},
      "volumeMounts": [
        {
          "volumeId": "worlds",
          "target": "/worlds",
          "readOnly": false
        },
        {
          "volumeId": "config",
          "target": "/configs",
          "readOnly": false
        }
      ],
      "dependsOn": [],
      "health": {
        "source": "running",
        "startupGraceSeconds": 600
      }
    }
  ],
  "volumes": [
    {
      "id": "worlds",
      "role": "save",
      "retention": "delete-with-server"
    },
    {
      "id": "config",
      "role": "config",
      "retention": "delete-with-server"
    }
  ],
  "ports": [
    {
      "id": "game",
      "componentId": "server",
      "containerPort": 7777,
      "containerPortMode": "fixed",
      "protocols": [
        "tcp",
        "udp"
      ],
      "exposure": "public",
      "purpose": "game",
      "primary": true,
      "sharedHostPort": true
    }
  ],
  "resources": {
    "defaultPresetId": "balanced",
    "presets": [
      {
        "id": "small",
        "title": {
          "en": "Small",
          "nl": "Klein",
          "de": "Klein"
        },
        "description": {
          "en": "For a small world with a few players.",
          "nl": "Voor een kleine wereld met enkele spelers.",
          "de": "Für eine kleine Welt mit wenigen Spielern."
        },
        "memoryMb": 1024,
        "diskMb": 4096,
        "cpuPercent": 100
      },
      {
        "id": "balanced",
        "title": {
          "en": "Balanced",
          "nl": "Gebalanceerd",
          "de": "Ausgewogen"
        },
        "description": {
          "en": "Recommended for a persistent cooperative world.",
          "nl": "Aanbevolen voor een blijvende coöperatieve wereld.",
          "de": "Für eine persistente kooperative Welt empfohlen."
        },
        "memoryMb": 2048,
        "diskMb": 8192,
        "cpuPercent": 150
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-steam-agreement",
      "type": "agreement",
      "label": {
        "en": "Steam Subscriber Agreement",
        "nl": "Steam Subscriber Agreement",
        "de": "Steam-Nutzungsvertrag"
      },
      "help": {
        "en": "I have read and accept the Steam Subscriber Agreement and the applicable game terms.",
        "nl": "Ik heb de Steam Subscriber Agreement en de toepasselijke gamevoorwaarden gelezen en accepteer deze.",
        "de": "Ich habe den Steam-Nutzungsvertrag und die anwendbaren Spielbedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://store.steampowered.com/subscriber_agreement/",
      "revision": "official-current"
    },
    {
      "key": "world-name",
      "type": "string",
      "label": {
        "en": "World name",
        "nl": "Wereldnaam",
        "de": "Weltname"
      },
      "help": {
        "en": "Name of the persistent Terraria world.",
        "nl": "Naam van de blijvende Terraria-wereld.",
        "de": "Name der persistenten Terraria-Welt."
      },
      "required": true,
      "defaultValue": "Dauva",
      "minLength": 1,
      "maxLength": 64
    },
    {
      "key": "world-size",
      "type": "integer",
      "label": {
        "en": "World size",
        "nl": "Wereldgrootte",
        "de": "Weltgröße"
      },
      "help": {
        "en": "World size: 1 small, 2 medium, or 3 large.",
        "nl": "Wereldgrootte: 1 klein, 2 middelgroot of 3 groot.",
        "de": "Weltgröße: 1 klein, 2 mittel oder 3 groß."
      },
      "required": true,
      "defaultValue": "2",
      "minLength": 1,
      "maxLength": 1
    },
    {
      "key": "max-players",
      "type": "integer",
      "label": {
        "en": "Maximum players",
        "nl": "Maximumaantal spelers",
        "de": "Maximale Spielerzahl"
      },
      "help": {
        "en": "Maximum simultaneous players.",
        "nl": "Maximaal aantal gelijktijdige spelers.",
        "de": "Maximale Anzahl gleichzeitiger Spieler."
      },
      "required": true,
      "defaultValue": "8",
      "minLength": 1,
      "maxLength": 3
    }
  ],
  "secrets": [
    {
      "key": "server-password",
      "source": "admin",
      "label": {
        "en": "Server password",
        "nl": "Serverwachtwoord",
        "de": "Serverpasswort"
      },
      "help": {
        "en": "Used only while Sprouting; the clear value is not stored in the Dauva Server record.",
        "nl": "Alleen gebruikt tijdens het ontkiemen; Dauva bewaart de leesbare waarde niet in het Server-record.",
        "de": "Wird nur beim Starten verwendet; der Klartextwert wird nicht im Dauva-Serverdatensatz gespeichert."
      },
      "minLength": 6,
      "maxLength": 128
    }
  ],
  "lifecycle": {
    "startOrder": [
      "server"
    ],
    "stopOrder": [
      "server"
    ],
    "stopTimeoutSeconds": 120
  },
  "capabilities": {
    "backup": false,
    "restore": false,
    "update": false,
    "console": false
  },
  "source": {
    "kind": "oci",
    "homepage": "https://terraria.org/",
    "repository": "https://github.com/BrammyS/Terraria",
    "imageRegistries": [
      "docker.io"
    ]
  },
  "trust": {
    "level": "curated",
    "reviewedAt": "2026-07-26",
    "mutableRuntimeImagesAllowed": false
  },
  "storage": {
    "class": "fast",
    "backupClass": "backup",
    "estimatedDownloadMb": 100,
    "estimatedInstallMb": 512,
    "estimatedMutableMb": 4096,
    "backupPolicy": "recommended"
  },
  "updatePolicy": {
    "discovery": "oci-tag",
    "automaticCheck": true,
    "automaticInstall": false,
    "requiresBackup": false,
    "rollback": true
  },
  "proofPolicy": {
    "requiredChecks": [
      "images-pinned",
      "healthy",
      "ports",
      "backup-if-supported",
      "graceful-stop",
      "restart",
      "persistence",
      "cleanup"
    ],
    "expiresAfterDays": 90
  }
}
