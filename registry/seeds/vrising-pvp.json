      "linux"
    ],
    "architectures": [
      "amd64"
    ],
    "leafCapabilities": [
      "dynamic-ports",
      "managed-game-updates-v1",
      "multi-port",
      "oci",
      "persistent-storage",
      "resource-limits"
    ]
  },
