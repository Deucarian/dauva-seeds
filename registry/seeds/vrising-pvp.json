        "SKIPUPDATE": "true",
        "UPDATE_ON_BOOT": "false",
        "VR_AUTOSAVESMARTKEEP": "10:1:1,30:0:1,60:0:1,120:0:1,180:0:1,240:0:1,360:0:1,720:0:1,1440:0:1,2880:0:1,52560000:99:0",
        "VR_LAN_MODE": "false",
