  "resources": {
    "defaultPresetId": "friends",
    "presets": [
      {
        "id": "friends",
        "title": {
          "en": "Friends",
          "nl": "Vrienden",
          "de": "Freunde"
        },
        "description": {
          "en": "8 GB RAM for a small private group.",
          "nl": "8 GB RAM voor een kleine privégroep.",
          "de": "8 GB RAM für eine kleine private Gruppe."
        },
        "memoryMb": 8192,
        "diskMb": 51200,
        "cpuPercent": 300
      },
      {
        "id": "clan",
        "title": {
          "en": "Clan",
          "nl": "Clan",
          "de": "Clan"
        },
        "description": {
          "en": "12 GB RAM and more CPU headroom for a larger group.",
          "nl": "12 GB RAM en meer CPU-ruimte voor een grotere groep.",
          "de": "12 GB RAM und mehr CPU-Spielraum für eine größere Gruppe."
        },
        "memoryMb": 12288,
        "diskMb": 76800,
        "cpuPercent": 400
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-steam-agreement",
      "type": "agreement",
      "label": {
        "en": "Steam Subscriber Agreement",
        "nl": "Steam Subscriber Agreement",
        "de": "Steam-Nutzungsvertrag"
      },
      "help": {
        "en": "I have read and accept the Steam Subscriber Agreement and the applicable V Rising terms.",
        "nl": "Ik heb de Steam Subscriber Agreement en de toepasselijke V Rising-voorwaarden gelezen en accepteer deze.",
        "de": "Ich habe den Steam-Nutzungsvertrag und die geltenden V-Rising-Bedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://store.steampowered.com/subscriber_agreement/",
      "revision": "official-current"
    },
    {
      "key": "description",
      "type": "string",
      "label": {
        "en": "Server description",
        "nl": "Serverbeschrijving",
        "de": "Serverbeschreibung"
      },
      "help": {
        "en": "Shown to players in the V Rising server details.",
        "nl": "Wordt aan spelers getoond in de V Rising-serverdetails.",
        "de": "Wird Spielern in den V-Rising-Serverdetails angezeigt."
      },
      "required": false,
      "defaultValue": "A private Dauva-managed V Rising Server.",
      "minLength": 0,
      "maxLength": 200
    },
    {
      "key": "max-players",
      "type": "integer",
      "label": {
        "en": "Maximum players",
        "nl": "Maximumaantal spelers",
        "de": "Maximale Spielerzahl"
      },
      "help": {
        "en": "Simultaneous player limit from 1 through 128.",
        "nl": "Limiet voor gelijktijdige spelers van 1 tot en met 128.",
        "de": "Limit gleichzeitiger Spieler von 1 bis 128."
      },
      "required": true,
      "defaultValue": "10",
      "minLength": 1,
      "maxLength": 3
    },
    {
      "key": "difficulty",
      "type": "string",
      "label": {
        "en": "Difficulty",
        "nl": "Moeilijkheid",
        "de": "Schwierigkeit"
      },
      "help": {
        "en": "Choose easy, normal, or brutal.",
        "nl": "Kies easy, normal of brutal.",
        "de": "Wähle easy, normal oder brutal."
      },
      "required": true,
      "defaultValue": "normal",
      "minLength": 4,
      "maxLength": 6
    },
    {
      "key": "password-protected",
      "type": "boolean",
      "label": {
        "en": "Password protection",
        "nl": "Wachtwoordbeveiliging",
        "de": "Passwortschutz"
      },
      "help": {
        "en": "Turn on to require the protected join password; turn off to allow direct joins without it.",
        "nl": "Zet aan om het beschermde toegangswachtwoord te vereisen; zet uit voor directe toegang zonder wachtwoord.",
        "de": "Einschalten, um das geschützte Beitrittspasswort zu verlangen; ausschalten für Direktbeitritt ohne Passwort."
      },
      "required": true,
      "defaultValue": "false",
      "minLength": 4,
      "maxLength": 5
    },
    {
      "key": "public-listing",
      "type": "boolean",
      "label": {
        "en": "Public server listing",
        "nl": "Openbare serverlijst",
        "de": "Öffentliche Serverliste"
      },
      "help": {
        "en": "Off keeps the world out of both EOS and Steam lists; direct connections still work.",
        "nl": "Uit houdt de wereld uit zowel de EOS- als Steam-lijst; directe verbindingen blijven werken.",
        "de": "Aus blendet die Welt in EOS- und Steam-Listen aus; Direktverbindungen funktionieren weiter."
      },
      "required": true,
      "defaultValue": "false",
      "minLength": 4,
      "maxLength": 5
    }
  ],
  "secrets": [
    {
      "key": "initial-administrators",
      "source": "admin",
      "required": false,
      "label": {
        "en": "Initial administrators",
        "nl": "Eerste beheerders",
        "de": "Erste Administratoren"
      },
      "help": {
        "en": "Optional at creation. Enter semicolon-separated Name=SteamID64 pairs, for example Sproeikoei=your 17-digit SteamID64, or add them later in Server settings.",
        "nl": "Optioneel bij het aanmaken. Voer met puntkomma's gescheiden Naam=SteamID64-paren in, bijvoorbeeld Sproeikoei=jouw 17-cijferige SteamID64, of voeg ze later toe in de Serverinstellingen.",
        "de": "Bei der Erstellung optional. Gib durch Semikolon getrennte Name=SteamID64-Paare ein, zum Beispiel Sproeikoei=deine 17-stellige SteamID64, oder füge sie später in den Servereinstellungen hinzu."
      },
      "minLength": 19,
      "maxLength": 4096
    },
    {
      "key": "join-password",
      "source": "admin",
      "required": false,
      "label": {
        "en": "Join password (optional)",
        "nl": "Toegangswachtwoord (optioneel)",
        "de": "Beitrittspasswort (optional)"
      },
      "help": {
        "en": "Leave blank for no join password. The value is protected and is never shown in ordinary Server records.",
        "nl": "Laat leeg voor geen toegangswachtwoord. De waarde wordt beschermd en nooit in gewone Servergegevens getoond.",
        "de": "Leer lassen für kein Beitrittspasswort. Der Wert wird geschützt und nie in normalen Serverdaten angezeigt."
      },
      "minLength": 4,
      "maxLength": 128
    }
  ],
