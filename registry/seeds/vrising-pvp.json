  "metadata": {
    "title": {
      "en": "V Rising PvP",
      "nl": "V Rising PvP",
      "de": "V Rising PvP"
    },
    "description": {
      "en": "Competitive player-versus-player world with raids and direct player conflict. Not the recommended default.",
      "nl": "Competitieve speler-tegen-spelerwereld met raids en direct conflict. Niet de aanbevolen standaard.",
      "de": "Kompetitive Spieler-gegen-Spieler-Welt mit Raids und direktem Konflikt. Nicht die empfohlene Vorgabe."
    },
    "icon": "flame"
  },
  "compatibility": {
