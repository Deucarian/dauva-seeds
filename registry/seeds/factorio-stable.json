{
  "schemaVersion": "dauva.dev/seed/v1",
  "id": "factorio-stable",
  "version": "1.0.0",
  "status": "stable",
  "podId": "factorio",
  "genres": [
    "automation",
    "simulation"
  ],
  "metadata": {
    "title": {
      "en": "Factorio Stable",
      "nl": "Factorio Stable",
      "de": "Factorio Stable"
    },
    "description": {
      "en": "A Factorio Server pinned to the stable release channel.",
      "nl": "Een Factorio-Server vastgezet op het stabiele releasekanaal.",
      "de": "Ein Factorio-Server auf dem stabilen Veröffentlichungskanal."
    },
    "icon": "settings"
  },
  "compatibility": {
    "operatingSystems": [
      "linux"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "components": [
    {
      "id": "server",
      "role": "primary",
      "image": "docker.io/factoriotools/factorio@sha256:7052b3cca8ca7790f99f4058617d5c8089df544de736b1baa23f2c5f58fb7f48",
      "environment": {
        "GENERATE_NEW_SAVE": "true",
        "LOAD_LATEST_SAVE": "true",
        "UPDATE_MODS_ON_START": "false"
      },
      "optionEnvironment": {
        "save-name": "SAVE_NAME"
      },
      "agreementEnvironment": {},
      "secretEnvironment": {},
      "runtimeEnvironment": {
        "primaryPort": "PORT"
      },
      "volumeMounts": [
        {
          "volumeId": "data",
          "target": "/factorio",
          "readOnly": false
        }
      ],
      "dependsOn": [],
      "health": {
        "source": "running",
        "startupGraceSeconds": 600
      }
    }
  ],
  "volumes": [
    {
      "id": "data",
      "role": "data",
      "retention": "delete-with-server"
    }
  ],
  "ports": [
    {
      "id": "game",
      "componentId": "server",
      "containerPort": 34197,
      "containerPortMode": "allocated",
      "protocols": [
        "udp"
      ],
      "exposure": "public",
      "purpose": "game",
      "primary": true,
      "sharedHostPort": true,
      "environment": "PORT"
    },
    {
      "id": "rcon",
      "componentId": "server",
      "containerPort": 27015,
      "containerPortMode": "fixed",
      "protocols": [
        "tcp"
      ],
      "exposure": "private",
      "purpose": "rcon",
      "primary": false,
      "sharedHostPort": true,
      "environment": "RCON_PORT"
    }
  ],
  "resources": {
    "defaultPresetId": "balanced",
    "presets": [
      {
        "id": "balanced",
        "title": {
          "en": "Balanced",
          "nl": "Gebalanceerd",
          "de": "Ausgewogen"
        },
        "description": {
          "en": "Recommended for an established factory with a small group.",
          "nl": "Aanbevolen voor een bestaande fabriek met een kleine groep.",
          "de": "Empfohlen für eine bestehende Fabrik mit einer kleinen Gruppe."
        },
        "memoryMb": 3072,
        "diskMb": 12288,
        "cpuPercent": 200
      }
    ]
  },
  "inputs": [
    {
      "key": "accept-factorio-terms",
      "type": "agreement",
      "label": {
        "en": "Factorio Terms of Service",
        "nl": "Factorio-gebruiksvoorwaarden",
        "de": "Factorio-Nutzungsbedingungen"
      },
      "help": {
        "en": "I have read and accept the official Factorio Terms of Service.",
        "nl": "Ik heb de officiële Factorio-gebruiksvoorwaarden gelezen en accepteer deze.",
        "de": "Ich habe die offiziellen Factorio-Nutzungsbedingungen gelesen und akzeptiert."
      },
      "required": true,
      "defaultValue": "false",
      "url": "https://www.factorio.com/terms-of-service",
      "revision": "2024-10-10"
    },
    {
      "key": "save-name",
      "type": "string",
      "label": {
        "en": "Save name",
        "nl": "Savenaam",
        "de": "Spielstandname"
      },
      "help": {
        "en": "Name used when a new save is generated.",
        "nl": "Naam die wordt gebruikt bij het maken van een nieuwe save.",
        "de": "Name für einen neu erzeugten Spielstand."
      },
      "required": true,
      "defaultValue": "dauva",
      "minLength": 3,
      "maxLength": 64
    }
  ],
  "secrets": [],
  "lifecycle": {
    "startOrder": [
      "server"
    ],
    "stopOrder": [
      "server"
    ],
    "stopTimeoutSeconds": 120
  },
  "capabilities": {
    "backup": false,
    "restore": false,
    "update": false,
    "console": false
  }
}
