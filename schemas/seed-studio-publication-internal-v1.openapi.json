{
  "openapi": "3.1.0",
  "info": {
    "title": "Dauva Seed publication workflow API",
    "version": "1.0.0",
    "description": "GitHub-OIDC-only claim, material download, monotonic callback, and Registry deployment receipt boundary. Browser sessions are never accepted."
  },
  "servers": [
    {
      "url": "/api/internal"
    }
  ],
  "security": [
    {
      "githubOidc": []
    }
  ],
  "paths": {
    "/seed-publications/{publicationId}/claim": {
      "post": {
        "operationId": "claimSeedPublication",
        "parameters": [
          {
            "$ref": "#/components/parameters/PublicationId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The exact run atomically owns this publication attempt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/seed-publications/{publicationId}/statement": {
      "get": {
        "operationId": "getSeedPublicationStatement",
        "parameters": [
          {
            "$ref": "#/components/parameters/PublicationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed target-bound publication statement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./seed-studio-publication-v1.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/seed-publications/{publicationId}/bundle": {
      "get": {
        "operationId": "downloadSeedPublicationBundle",
        "parameters": [
          {
            "$ref": "#/components/parameters/PublicationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable signed release bundle bound by the publication statement.",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "maxLength": 314572800
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/seed-publications/{publicationId}/events": {
      "post": {
        "operationId": "recordSeedPublicationEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PublicationId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowEvent"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The event was durably accepted or was an exact idempotent replay."
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/seed-registry-deployments": {
      "post": {
        "operationId": "recordSeedRegistryDeployment",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./seed-registry-deployment-receipt-v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The deployment receipt was durably accepted or was an exact replay."
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "githubOidc": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A fresh GitHub Actions OIDC token with the environment-specific audience and exact repository, actor, workflow, ref, run, and attempt claims."
      }
    },
    "parameters": {
      "PublicationId": {
        "name": "publicationId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe typed failure without workflow logs, credentials, tokens, or paths.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Uuid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "ClaimRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "runAttempt"
        ],
        "properties": {
          "runId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "runAttempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "ClaimResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "publicationId",
          "environment",
          "targetRef",
          "statementPath",
          "bundlePath",
          "archiveDigest"
        ],
        "properties": {
          "schemaVersion": {
            "const": "dauva.dev/seed-publication-claim/v1"
          },
          "publicationId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "environment": {
            "enum": [
              "develop",
              "production"
            ]
          },
          "targetRef": {
            "enum": [
              "refs/heads/develop",
              "refs/heads/main"
            ]
          },
          "statementPath": {
            "type": "string",
            "pattern": "^/api/internal/seed-publications/[0-9a-f-]{36}/statement$"
          },
          "bundlePath": {
            "type": "string",
            "pattern": "^/api/internal/seed-publications/[0-9a-f-]{36}/bundle$"
          },
          "archiveDigest": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "WorkflowEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalEventId",
          "phase",
          "outcome",
          "code",
          "parameters"
        ],
        "properties": {
          "externalEventId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "phase": {
            "enum": [
              "claiming",
              "verifying_bundle",
              "applying_bundle",
              "checking",
              "opening_review",
              "waiting_for_review"
            ]
          },
          "outcome": {
            "enum": [
              "started",
              "succeeded",
              "blocked",
              "failed"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 512
            },
            "maxProperties": 16
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
