{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-registry-deployment-receipt-v1.schema.json",
  "title": "Dauva Seed Registry deployment receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentPayload",
    "deploymentDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed-registry-deployment-receipt/v1"
    },
    "deploymentPayload": {
      "$ref": "#/$defs/deploymentPayload"
    },
    "deploymentDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "deploymentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "publicationId",
        "environment",
        "repositoryId",
        "repository",
        "targetRef",
        "commitSha",
        "previousCommitSha",
        "registryDigest",
        "registryFileDigest",
        "workflowRunId",
        "workflowRunAttempt",
        "jobWorkflowRef",
        "deployedAtUtc",
        "verifiedAtUtc",
        "health"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "#/$defs/uuid"
        },
        "publicationId": {
          "$ref": "#/$defs/uuid"
        },
        "environment": {
          "enum": [
            "develop",
            "production"
          ]
        },
        "repositoryId": {
          "const": 1311366821
        },
        "repository": {
          "const": "Deucarian/dauva-seeds"
        },
        "targetRef": {
          "enum": [
            "refs/heads/develop",
            "refs/heads/main"
          ]
        },
        "commitSha": {
          "$ref": "#/$defs/gitObjectId"
        },
        "previousCommitSha": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "registryDigest": {
          "$ref": "#/$defs/digest"
        },
        "registryFileDigest": {
          "$ref": "#/$defs/digest"
        },
        "workflowRunId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workflowRunAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "jobWorkflowRef": {
          "const": "Deucarian/dauva-seeds/.github/workflows/_seed-registry-deploy.yml@refs/heads/main"
        },
        "deployedAtUtc": {
          "$ref": "#/$defs/timestamp"
        },
        "verifiedAtUtc": {
          "$ref": "#/$defs/timestamp"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiCommitSha",
            "apiRegistryDigest"
          ],
          "properties": {
            "apiCommitSha": {
              "$ref": "#/$defs/gitObjectId"
            },
            "apiRegistryDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "environment": {
                "const": "develop"
              }
            },
            "required": [
              "environment"
            ]
          },
          "then": {
            "properties": {
              "targetRef": {
                "const": "refs/heads/develop"
              }
            }
          },
          "else": {
            "properties": {
              "targetRef": {
                "const": "refs/heads/main"
              }
            }
          }
        }
      ]
    }
  }
}
