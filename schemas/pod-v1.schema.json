{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/pod-v1.schema.json",
  "title": "Dauva Pod v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/pod/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "stable",
        "withered"
      ]
    },
    "recommendedSeedId": {
      "$ref": "#/$defs/id"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "nl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "icon"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 2,
          "maxLength": 64
        }
      }
    }
  }
}
