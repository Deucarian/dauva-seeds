{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-release-bundle-v1.schema.json",
  "title": "Dauva Seed release bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundlePayload",
    "exportDigest",
    "studioAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed-release-bundle/v1"
    },
    "bundlePayload": {
      "$ref": "#/$defs/bundlePayload"
    },
    "exportDigest": {
      "$ref": "#/$defs/digest"
    },
    "studioAttestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "versionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "preApply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedDigest"
          ],
          "properties": {
            "expectedDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedAbsent"
          ],
          "properties": {
            "expectedAbsent": {
              "const": true
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "preApply",
        "postApplyDigest",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?:registry/(?:pods|seeds)/[a-z0-9]+(?:-[a-z0-9]+)*\\.json|registry/history/[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+\\.json|proofs/[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[1-9][0-9]*)?-(?:amd64|arm64)-[0-9a-f-]{36}\\.json|dist/registry\\.json|package\\.json|package-lock\\.json)$"
        },
        "preApply": {
          "$ref": "#/$defs/preApply"
        },
        "postApplyDigest": {
          "$ref": "#/$defs/digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "semanticVersionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "from",
        "to",
        "impact"
      ],
      "properties": {
        "package": {
          "const": "@deucarian/dauva-seeds"
        },
        "from": {
          "$ref": "#/$defs/semanticVersion"
        },
        "to": {
          "$ref": "#/$defs/semanticVersion"
        },
        "impact": {
          "enum": [
            "patch",
            "minor",
            "major"
          ]
        }
      }
    },
    "proofReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seedId",
        "testedVersion",
        "architecture",
        "proofId",
        "receiptDigest",
        "expiresAt"
      ],
      "properties": {
        "seedId": {
          "$ref": "seed-v1.schema.json#/$defs/id"
        },
        "testedVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?$"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "proofId": {
          "$ref": "#/$defs/uuid"
        },
        "receiptDigest": {
          "$ref": "#/$defs/digest"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "bundlePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "workspaceId",
        "revisionGroupId",
        "createdAt",
        "baseGitCommit",
        "baseRegistryDigest",
        "engineVersion",
        "semanticVersions",
        "proofReceipts",
        "files"
      ],
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/uuid"
        },
        "workspaceId": {
          "$ref": "#/$defs/uuid"
        },
        "revisionGroupId": {
          "$ref": "#/$defs/uuid"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "baseGitCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "baseRegistryDigest": {
          "$ref": "#/$defs/digest"
        },
        "engineVersion": {
          "$ref": "#/$defs/versionLabel"
        },
        "semanticVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticVersionChange"
          }
        },
        "proofReceipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proofReceipt"
          }
        },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  }
}
