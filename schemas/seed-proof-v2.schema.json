{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-proof-v2.schema.json",
  "title": "Dauva Seed proof v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptPayload",
    "receiptDigest",
    "leafAttestation",
    "apiAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed-proof/v2"
    },
    "receiptPayload": {
      "$ref": "#/$defs/receiptPayload"
    },
    "receiptDigest": {
      "$ref": "#/$defs/digest"
    },
    "leafAttestation": {
      "$ref": "#/$defs/attestation"
    },
    "apiAttestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?$"
    },
    "versionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "testedVersion",
        "intendedStableVersion",
        "manifestDigest",
        "proofContractDigest"
      ],
      "properties": {
        "id": {
          "$ref": "seed-v1.schema.json#/$defs/id"
        },
        "testedVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "intendedStableVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "proofContractDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leafId",
        "leafKeyId",
        "agentVersion",
        "runtimeVersion",
        "operatingSystem",
        "architecture"
      ],
      "properties": {
        "leafId": {
          "$ref": "#/$defs/opaqueId"
        },
        "leafKeyId": {
          "$ref": "#/$defs/digest"
        },
        "agentVersion": {
          "$ref": "#/$defs/versionLabel"
        },
        "runtimeVersion": {
          "$ref": "#/$defs/versionLabel"
        },
        "operatingSystem": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "status",
        "startedAt",
        "completedAt",
        "evidenceDigests"
      ],
      "properties": {
        "code": {
          "enum": [
            "images-pinned",
            "healthy",
            "ports",
            "backup",
            "restore",
            "graceful-stop",
            "stopped-remains-stopped",
            "restart",
            "persistence",
            "console",
            "update",
            "backup-if-supported",
            "runtime-version",
            "managed-update",
            "rollback",
            "cleanup"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "not_applicable"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceDigests": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "url",
        "revision",
        "actorId",
        "accepted",
        "acceptedAt"
      ],
      "properties": {
        "key": {
          "$ref": "seed-v1.schema.json#/$defs/id"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actorId": {
          "$ref": "#/$defs/opaqueId"
        },
        "accepted": {
          "const": true
        },
        "acceptedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "code",
        "digest",
        "mediaType",
        "summary"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "mediaType": {
          "enum": [
            "application/json",
            "text/plain"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "cleanupResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers",
        "networks",
        "volumes",
        "ports",
        "directories",
        "backups",
        "secrets"
      ],
      "properties": {
        "containers": {
          "const": 0
        },
        "networks": {
          "const": 0
        },
        "volumes": {
          "const": 0
        },
        "ports": {
          "const": 0
        },
        "directories": {
          "const": 0
        },
        "backups": {
          "const": 0
        },
        "secrets": {
          "const": 0
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completedAt",
        "journalDigest",
        "resources"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "journalDigest": {
          "$ref": "#/$defs/digest"
        },
        "resources": {
          "$ref": "#/$defs/cleanupResources"
        }
      }
    },
    "receiptPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofId",
        "runId",
        "attemptId",
        "revisionId",
        "runStatementDigest",
        "seed",
        "proofPlanDigest",
        "baseRegistryDigest",
        "proofBundleDigest",
        "policyVersion",
        "validatorVersion",
        "runner",
        "startedAt",
        "completedAt",
        "expiresAt",
        "result",
        "checks",
        "agreements",
        "evidence",
        "cleanup"
      ],
      "properties": {
        "proofId": {
          "$ref": "#/$defs/uuid"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "revisionId": {
          "$ref": "#/$defs/uuid"
        },
        "runStatementDigest": {
          "$ref": "#/$defs/digest"
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "proofPlanDigest": {
          "$ref": "#/$defs/digest"
        },
        "baseRegistryDigest": {
          "$ref": "#/$defs/digest"
        },
        "proofBundleDigest": {
          "$ref": "#/$defs/digest"
        },
        "policyVersion": {
          "$ref": "#/$defs/versionLabel"
        },
        "validatorVersion": {
          "$ref": "#/$defs/versionLabel"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "result": {
          "const": "passed"
        },
        "checks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "agreements": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/agreement"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        }
      }
    }
  }
}
