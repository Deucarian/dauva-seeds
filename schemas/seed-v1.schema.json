{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-v1.schema.json",
  "title": "Dauva Seed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "podId",
    "genres",
    "metadata",
    "source",
    "trust",
    "compatibility",
    "components",
    "volumes",
    "ports",
    "resources",
    "storage",
    "inputs",
    "secrets",
    "lifecycle",
    "capabilities",
    "updatePolicy",
    "proofPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "stable",
        "withered"
      ]
    },
    "podId": {
      "$ref": "#/$defs/id"
    },
    "genres": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystems",
        "architectures",
        "leafCapabilities"
      ],
      "properties": {
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux"
            ]
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "leafCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "runtimeVersion": {
      "$ref": "#/$defs/runtimeVersion"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "volumes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/volume"
      }
    },
    "ports": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "secrets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/secret"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "console": {
      "$ref": "#/$defs/console"
    },
    "updatePolicy": {
      "$ref": "#/$defs/updatePolicy"
    },
    "proofPolicy": {
      "$ref": "#/$defs/proofPolicy"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 120
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "nl",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "nl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "icon"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 2,
          "maxLength": 64
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "homepage",
        "repository",
        "imageRegistries"
      ],
      "properties": {
        "kind": {
          "enum": [
            "oci",
            "steamcmd",
            "linuxgsm",
            "dauva"
          ]
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "imageRegistries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+(?::[0-9]+)?$",
            "maxLength": 253
          }
        },
        "upstreamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reviewedAt",
        "mutableRuntimeImagesAllowed"
      ],
      "properties": {
        "level": {
          "enum": [
            "community",
            "curated",
            "verified",
            "official"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "mutableRuntimeImagesAllowed": {
          "const": false
        }
      }
    },
    "runtimeVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "componentId",
        "volumeId",
        "path",
        "channel"
      ],
      "properties": {
        "strategy": {
          "const": "steam-app-manifest"
        },
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "volumeId": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
          "minLength": 1,
          "maxLength": 512
        },
        "channel": {
          "enum": [
            "stable",
            "experimental"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "image",
        "imageUpdate",
        "environment",
        "optionEnvironment",
        "agreementEnvironment",
        "secretEnvironment",
        "runtimeEnvironment",
        "volumeMounts",
        "dependsOn",
        "health"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "primary",
            "companion"
          ]
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$",
          "maxLength": 500
        },
        "imageUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+:[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
              "maxLength": 500
            }
          }
        },
        "stopSignal": {
          "enum": [
            "SIGINT",
            "SIGTERM"
          ]
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/environmentName"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "optionEnvironment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentName"
          }
        },
        "agreementEnvironment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "acceptedValue"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/environmentName"
              },
              "acceptedValue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "secretEnvironment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentName"
          }
        },
        "runtimeEnvironment": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "serverName",
              "memoryMb",
              "memoryMbLower",
              "primaryPort",
              "timezone"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentName"
          }
        },
        "volumeMounts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "volumeId",
              "target",
              "readOnly"
            ],
            "properties": {
              "volumeId": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "type": "string",
                "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                "maxLength": 300
              },
              "readOnly": {
                "type": "boolean"
              }
            }
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "container",
                "running"
              ]
            },
            "startupGraceSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "retention"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "data",
            "save",
            "config",
            "cache",
            "backup"
          ]
        },
        "retention": {
          "enum": [
            "delete-with-server",
            "retain-on-delete",
            "disposable"
          ]
        },
        "ownerUid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ownerGid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "directoryMode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "containerPort",
        "containerPortMode",
        "protocols",
        "exposure",
        "purpose",
        "primary",
        "sharedHostPort"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "containerPortMode": {
          "enum": [
            "fixed",
            "allocated"
          ]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        },
        "exposure": {
          "enum": [
            "public",
            "private"
          ]
        },
        "purpose": {
          "enum": [
            "game",
            "query",
            "rcon",
            "voice",
            "file-transfer",
            "messaging"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "sharedHostPort": {
          "type": "boolean"
        },
        "environment": {
          "$ref": "#/$defs/environmentName"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultPresetId",
        "presets"
      ],
      "properties": {
        "defaultPresetId": {
          "$ref": "#/$defs/id"
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description",
              "memoryMb",
              "diskMb",
              "cpuPercent"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "$ref": "#/$defs/localizedText"
              },
              "description": {
                "$ref": "#/$defs/localizedText"
              },
              "memoryMb": {
                "type": "integer",
                "minimum": 256,
                "maximum": 131072
              },
              "diskMb": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 2097152
              },
              "cpuPercent": {
                "type": "integer",
                "minimum": 25,
                "maximum": 6400
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "backupClass",
        "estimatedDownloadMb",
        "estimatedInstallMb",
        "estimatedMutableMb",
        "backupPolicy"
      ],
      "properties": {
        "class": {
          "enum": [
            "fast",
            "bulk"
          ]
        },
        "backupClass": {
          "enum": [
            "backup",
            "bulk"
          ]
        },
        "estimatedDownloadMb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "estimatedInstallMb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "estimatedMutableMb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "backupPolicy": {
          "enum": [
            "optional",
            "recommended",
            "required"
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "label",
        "help",
        "required"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "agreement"
          ]
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "help": {
          "$ref": "#/$defs/localizedText"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": "string",
          "maxLength": 2000
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "agreement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url",
              "revision"
            ],
            "properties": {
              "defaultValue": {
                "const": "false"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "source"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "enum": [
            "generated",
            "admin"
          ]
        },
        "generatedBytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 128
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "help": {
          "$ref": "#/$defs/localizedText"
        },
        "minLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "generated"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "generatedBytes"
            ],
            "properties": {
              "generatedBytes": {
                "type": "integer",
                "minimum": 16,
                "maximum": 128
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "admin"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/localizedText"
              }
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startOrder",
        "stopOrder",
        "stopTimeoutSeconds"
      ],
      "properties": {
        "startOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "stopOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "stopTimeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup",
        "restore",
        "update",
        "console"
      ],
      "properties": {
        "backup": {
          "type": "boolean"
        },
        "restore": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "componentId",
        "portId",
        "secretKey",
        "maxCommandLength"
      ],
      "properties": {
        "protocol": {
          "const": "source-rcon"
        },
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "portId": {
          "$ref": "#/$defs/id"
        },
        "secretKey": {
          "$ref": "#/$defs/id"
        },
        "maxCommandLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      }
    },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "automaticCheck",
        "automaticInstall",
        "requiresBackup",
        "rollback"
      ],
      "properties": {
        "discovery": {
          "enum": [
            "oci-tag",
            "github-release",
            "steamcmd",
            "manual"
          ]
        },
        "automaticCheck": {
          "type": "boolean"
        },
        "automaticInstall": {
          "const": false
        },
        "requiresBackup": {
          "type": "boolean"
        },
        "rollback": {
          "type": "boolean"
        },
        "strategy": {
          "const": "steamcmd"
        },
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "volumeId": {
          "$ref": "#/$defs/id"
        },
        "installDirectory": {
          "type": "string",
          "pattern": "^/(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
          "minLength": 2,
          "maxLength": 512
        },
        "appId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 20
        },
        "branch": {
          "enum": [
            "public",
            "experimental"
          ]
        },
        "validate": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "strategy": [
          "componentId",
          "volumeId",
          "installDirectory",
          "appId",
          "branch",
          "validate"
        ]
      }
    },
    "proofPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredChecks",
        "expiresAfterDays"
      ],
      "properties": {
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "images-pinned",
              "healthy",
              "ports",
              "backup-if-supported",
              "runtime-version",
              "managed-update",
              "rollback",
              "graceful-stop",
              "restart",
              "persistence",
              "cleanup"
            ]
          }
        },
        "expiresAfterDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    }
  }
}
