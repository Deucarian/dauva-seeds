{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-studio-verification-roots-v1.schema.json",
  "title": "Dauva Seed Studio public verification roots v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed-studio-verification-roots/v1"
    },
    "keys": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/key"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "keyId",
        "publicKey",
        "subjects",
        "status",
        "addedAt",
        "revokedAt"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "proof_leaf",
            "proof_api",
            "studio_export"
          ]
        },
        "keyId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "addedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revokedAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
