{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dauva.dev/schemas/seed-studio-publication-v1.schema.json",
  "title": "Dauva Seed Studio publication statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationPayload",
    "publicationDigest",
    "studioAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dauva.dev/seed-publication/v1"
    },
    "publicationPayload": {
      "$ref": "#/$defs/publicationPayload"
    },
    "publicationDigest": {
      "$ref": "#/$defs/digest"
    },
    "studioAttestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "publicationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationId",
        "exportId",
        "exportDigest",
        "archiveDigest",
        "sourceEnvironment",
        "repositoryId",
        "repository",
        "targetRef",
        "baseGitCommit",
        "baseRegistryDigest",
        "expectedRegistryDigest",
        "createdAtUtc",
        "claimBeforeUtc"
      ],
      "properties": {
        "publicationId": {
          "$ref": "#/$defs/uuid"
        },
        "exportId": {
          "$ref": "#/$defs/uuid"
        },
        "exportDigest": {
          "$ref": "#/$defs/digest"
        },
        "archiveDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceEnvironment": {
          "enum": [
            "develop",
            "production"
          ]
        },
        "repositoryId": {
          "const": 1311366821
        },
        "repository": {
          "const": "Deucarian/dauva-seeds"
        },
        "targetRef": {
          "enum": [
            "refs/heads/develop",
            "refs/heads/main"
          ]
        },
        "baseGitCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "baseRegistryDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedRegistryDigest": {
          "$ref": "#/$defs/digest"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/timestamp"
        },
        "claimBeforeUtc": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceEnvironment": {
                "const": "develop"
              }
            },
            "required": [
              "sourceEnvironment"
            ]
          },
          "then": {
            "properties": {
              "targetRef": {
                "const": "refs/heads/develop"
              }
            }
          },
          "else": {
            "properties": {
              "targetRef": {
                "const": "refs/heads/main"
              }
            }
          }
        }
      ]
    }
  }
}
